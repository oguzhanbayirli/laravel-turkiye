{
    "name": "oguzhanbayirli/laravel-turkiye",
    "description": "Turkish identity number (TCKN), tax number (VKN) and IBAN validation, amounts in Turkish words, and TCMB exchange rates for Laravel.",
    "keywords": [
        "turkey",
        "turkiye",
        "tckn",
        "vkn",
        "iban",
        "tcmb",
        "laravel",
        "validation",
        "number-to-words",
        "exchange-rates"
    ],
    "homepage": "https://github.com/oguzhanbayirli/laravel-turkiye",
    "license": "MIT",
    "authors": [
        {
            "name": "Oğuzhan Bayırlı",
            "homepage": "https://github.com/oguzhanbayirli",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/oguzhanbayirli/laravel-turkiye/issues",
        "source": "https://github.com/oguzhanbayirli/laravel-turkiye"
    },
    "require": {
        "php": "^8.2",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0"
    },
    "autoload": {
        "psr-4": {
            "OguzhanBayirli\\Turkiye\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OguzhanBayirli\\Turkiye\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OguzhanBayirli\\Turkiye\\TurkiyeServiceProvider"
            ],
            "aliases": {
                "AmountInWords": "OguzhanBayirli\\Turkiye\\Facades\\AmountInWords",
                "Tcmb": "OguzhanBayirli\\Turkiye\\Facades\\Tcmb"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
